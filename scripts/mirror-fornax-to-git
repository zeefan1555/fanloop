#!/usr/bin/env python3
"""Copy a Fornax snapshot's workflow trees into a Git checkout."""

import os
import shutil
import stat
import sys


def main() -> None:
    if len(sys.argv) != 3:
        raise SystemExit("usage: mirror-fornax-to-git <snapshot-dir> <checkout-dir>")
    snapshot = os.path.abspath(sys.argv[1])
    checkout = os.path.abspath(sys.argv[2])
    source = os.path.join(snapshot, "fanloop-workflow")
    if not os.path.isdir(source) or os.path.islink(source):
        raise SystemExit("snapshot is missing fanloop-workflow")
    destination_root = os.path.join(checkout, "fanloop-workflow")
    os.makedirs(destination_root, 0o755, exist_ok=True)
    for workflow_id in sorted(os.listdir(source)):
        workflow_source = os.path.join(source, workflow_id)
        if os.path.islink(workflow_source) or not os.path.isdir(workflow_source):
            raise SystemExit("workflow entry must be a real directory")
        workflow_destination = os.path.join(destination_root, workflow_id)
        if os.path.lexists(workflow_destination):
            if os.path.islink(workflow_destination):
                raise SystemExit("checkout workflow path is a symlink")
            shutil.rmtree(workflow_destination)
        copy_tree(workflow_source, workflow_destination)


def copy_tree(source: str, destination: str) -> None:
    os.mkdir(destination, 0o755)
    for dirpath, dirnames, filenames in os.walk(source):
        dirnames.sort()
        relative = os.path.relpath(dirpath, source)
        current = destination if relative == "." else os.path.join(destination, relative)
        for name in sorted(dirnames):
            path = os.path.join(dirpath, name)
            if os.path.islink(path):
                raise SystemExit("snapshot contains a symlink")
            os.mkdir(os.path.join(current, name), 0o755)
        for name in sorted(filenames):
            path = os.path.join(dirpath, name)
            if os.path.islink(path) or not stat.S_ISREG(os.lstat(path).st_mode):
                raise SystemExit("snapshot contains a special file")
            target = os.path.join(current, name)
            with open(path, "rb") as incoming, open(target, "wb") as outgoing:
                outgoing.write(incoming.read())
            mode = 0o444
            if os.lstat(path).st_mode & 0o111:
                mode = 0o555
            os.chmod(target, mode)


if __name__ == "__main__":
    main()
