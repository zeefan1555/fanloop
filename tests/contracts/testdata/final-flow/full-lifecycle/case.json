{
  "schema_version": 1,
  "id": "technical-solution-design-full-lifecycle",
  "commands": [
    {"args": ["flow", "init", "--root", "{{ROOT}}", "--workflow", "technical-solution-design", "--title", "Technical Solution Contract"]},
    {"args": ["flow", "status", "--root", "{{ROOT}}"]},
    {"args": ["flow", "report", "progress", "--root", "{{ROOT}}", "--step-id", "frame_technical_problem", "--status", "in_progress", "--summary", "framing technical problem"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "frame_technical_problem", "--condition-result", "{\"condition_id\":\"technical_problem_defined\",\"output\":{\"type\":\"path\",\"value\":\".technical-solution/problem.md\"}}", "--next-step-id", "confirm_technical_problem", "--summary", "technical problem defined"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "confirm_technical_problem", "--condition-result", "{\"condition_id\":\"panorama_card_published\",\"output\":{\"type\":\"string\",\"value\":\"receipt-contract-problem\"}}", "--condition-result", "{\"condition_id\":\"technical_problem_approved\",\"output\":{\"type\":\"enum_value\",\"value\":\"approved\"}}", "--next-step-id", "derive_technical_solution", "--summary", "technical problem approved", "--evidence", "{\"source\":\"human\",\"content\":\"approved\",\"ref\":\"contract-problem-approval\"}"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "derive_technical_solution", "--condition-result", "{\"condition_id\":\"technical_solution_derived\",\"output\":{\"type\":\"path\",\"value\":\".technical-solution/proposal.md\"}}", "--next-step-id", "confirm_solution_direction", "--summary", "technical solution derived"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "confirm_solution_direction", "--condition-result", "{\"condition_id\":\"panorama_card_published\",\"output\":{\"type\":\"string\",\"value\":\"receipt-contract-direction\"}}", "--condition-result", "{\"condition_id\":\"solution_direction_approved\",\"output\":{\"type\":\"enum_value\",\"value\":\"approved\"}}", "--next-step-id", "write_technical_solution", "--summary", "solution direction approved", "--evidence", "{\"source\":\"human\",\"content\":\"approved\",\"ref\":\"contract-direction-approval\"}"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "write_technical_solution", "--condition-result", "{\"condition_id\":\"technical_solution_written\",\"output\":{\"type\":\"path\",\"value\":\"technical-solution.md\"}}", "--condition-result", "{\"condition_id\":\"architecture_diagram_written\",\"output\":{\"type\":\"path\",\"value\":\".technical-solution/architecture.mmd\"}}", "--next-step-id", "review_technical_solution", "--summary", "technical solution written"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "review_technical_solution", "--condition-result", "{\"condition_id\":\"technical_solution_review_passed\",\"output\":{\"type\":\"enum_value\",\"value\":\"passed\"}}", "--condition-result", "{\"condition_id\":\"technical_solution_review_written\",\"output\":{\"type\":\"path\",\"value\":\".technical-solution/review.md\"}}", "--next-step-id", "confirm_technical_solution", "--summary", "technical solution review passed"]},
    {"args": ["card", "render", "--root", "{{ROOT}}", "--dry-run", "--view", "panorama", "--format", "markdown"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "confirm_technical_solution", "--condition-result", "{\"condition_id\":\"panorama_card_published\",\"output\":{\"type\":\"string\",\"value\":\"receipt-contract-solution\"}}", "--condition-result", "{\"condition_id\":\"technical_solution_approved\",\"output\":{\"type\":\"enum_value\",\"value\":\"approved\"}}", "--terminal", "--summary", "technical solution approved", "--evidence", "{\"source\":\"human\",\"content\":\"approved\",\"ref\":\"contract-solution-approval\"}"]},
    {"args": ["flow", "status", "--root", "{{ROOT}}"]}
  ]
}
