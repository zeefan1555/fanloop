{
  "schema_version": 1,
  "id": "technical-solution-design-full-lifecycle",
  "commands": [
    {"args": ["flow", "init", "--root", "{{ROOT}}", "--workflow", "technical-solution-design", "--title", "Technical Solution Contract"]},
    {"args": ["flow", "status", "--root", "{{ROOT}}"]},
    {"args": ["flow", "report", "progress", "--root", "{{ROOT}}", "--step-id", "frame_requirement_background", "--status", "in_progress", "--summary", "framing requirement background"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "frame_requirement_background", "--condition-result", "{\"condition_id\":\"background_defined\",\"output\":{\"type\":\"path\",\"value\":\".technical-solution/sections/01-background.md\"}}", "--next-step-id", "analyze_core_problem", "--summary", "background defined"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "analyze_core_problem", "--condition-result", "{\"condition_id\":\"core_problem_defined\",\"output\":{\"type\":\"path\",\"value\":\".technical-solution/sections/02-problem.md\"}}", "--next-step-id", "define_design_objectives", "--summary", "core problem defined"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "define_design_objectives", "--condition-result", "{\"condition_id\":\"design_objectives_defined\",\"output\":{\"type\":\"path\",\"value\":\".technical-solution/sections/03-objectives.md\"}}", "--next-step-id", "confirm_technical_problem", "--summary", "design objectives defined"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "confirm_technical_problem", "--condition-result", "{\"condition_id\":\"problem_document_published\",\"output\":{\"type\":\"url\",\"value\":\"https://example.com/problem-definition\"}}", "--condition-result", "{\"condition_id\":\"panorama_card_published\",\"output\":{\"type\":\"path\",\"value\":\".fanloop/card/contract-problem.json\"}}", "--condition-result", "{\"condition_id\":\"technical_problem_approved\",\"output\":{\"type\":\"enum_value\",\"value\":\"approved\"}}", "--next-step-id", "research_solution_options", "--summary", "technical problem approved", "--evidence", "{\"source\":\"human\",\"content\":\"approved\",\"ref\":\"contract-problem-approval\"}"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "research_solution_options", "--condition-result", "{\"condition_id\":\"solution_research_completed\",\"output\":{\"type\":\"path\",\"value\":\".technical-solution/sections/04-research.md\"}}", "--next-step-id", "design_overall_solution", "--summary", "solution research completed"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "design_overall_solution", "--condition-result", "{\"condition_id\":\"overall_solution_designed\",\"output\":{\"type\":\"path\",\"value\":\".technical-solution/sections/05-overall-solution.md\"}}", "--condition-result", "{\"condition_id\":\"architecture_diagram_written\",\"output\":{\"type\":\"path\",\"value\":\".technical-solution/architecture.mmd\"}}", "--next-step-id", "design_key_solutions", "--summary", "overall solution designed"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "design_key_solutions", "--condition-result", "{\"condition_id\":\"key_solutions_designed\",\"output\":{\"type\":\"path\",\"value\":\".technical-solution/sections/06-key-solutions.md\"}}", "--next-step-id", "confirm_solution_direction", "--summary", "key solutions designed"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "confirm_solution_direction", "--condition-result", "{\"condition_id\":\"solution_document_published\",\"output\":{\"type\":\"url\",\"value\":\"https://example.com/solution-design\"}}", "--condition-result", "{\"condition_id\":\"panorama_card_published\",\"output\":{\"type\":\"path\",\"value\":\".fanloop/card/contract-direction.json\"}}", "--condition-result", "{\"condition_id\":\"solution_direction_approved\",\"output\":{\"type\":\"enum_value\",\"value\":\"approved\"}}", "--next-step-id", "evaluate_solution_benefits", "--summary", "solution direction approved", "--evidence", "{\"source\":\"human\",\"content\":\"approved\",\"ref\":\"contract-direction-approval\"}"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "evaluate_solution_benefits", "--condition-result", "{\"condition_id\":\"solution_benefits_defined\",\"output\":{\"type\":\"path\",\"value\":\".technical-solution/sections/07-benefits.md\"}}", "--next-step-id", "plan_solution_delivery", "--summary", "solution benefits defined"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "plan_solution_delivery", "--condition-result", "{\"condition_id\":\"delivery_plan_defined\",\"output\":{\"type\":\"path\",\"value\":\".technical-solution/sections/08-delivery.md\"}}", "--next-step-id", "write_technical_solution", "--summary", "delivery plan defined"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "write_technical_solution", "--condition-result", "{\"condition_id\":\"technical_solution_written\",\"output\":{\"type\":\"path\",\"value\":\"technical-solution.md\"}}", "--next-step-id", "review_technical_solution", "--summary", "technical solution written"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "review_technical_solution", "--condition-result", "{\"condition_id\":\"technical_solution_review_passed\",\"output\":{\"type\":\"enum_value\",\"value\":\"passed\"}}", "--condition-result", "{\"condition_id\":\"technical_solution_review_written\",\"output\":{\"type\":\"path\",\"value\":\".technical-solution/review.md\"}}", "--next-step-id", "confirm_technical_solution", "--summary", "technical solution review passed"]},
    {"args": ["card", "render", "--root", "{{ROOT}}", "--dry-run", "--view", "panorama", "--format", "markdown"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "confirm_technical_solution", "--condition-result", "{\"condition_id\":\"technical_solution_document_published\",\"output\":{\"type\":\"url\",\"value\":\"https://example.com/technical-solution\"}}", "--condition-result", "{\"condition_id\":\"panorama_card_published\",\"output\":{\"type\":\"path\",\"value\":\".fanloop/card/contract-solution.json\"}}", "--condition-result", "{\"condition_id\":\"technical_solution_approved\",\"output\":{\"type\":\"enum_value\",\"value\":\"approved\"}}", "--terminal", "--summary", "technical solution approved", "--evidence", "{\"source\":\"human\",\"content\":\"approved\",\"ref\":\"contract-solution-approval\"}"]},
    {"args": ["flow", "status", "--root", "{{ROOT}}"]}
  ]
}
