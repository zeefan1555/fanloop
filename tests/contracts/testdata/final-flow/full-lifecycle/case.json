{
  "schema_version": 1,
  "id": "promotion-design-full-lifecycle",
  "commands": [
    {"args": ["flow", "init", "--root", "{{ROOT}}", "--workflow", "promotion-design", "--title", "Promotion Design Contract"]},
    {"args": ["flow", "status", "--root", "{{ROOT}}"]},
    {"args": ["flow", "report", "progress", "--root", "{{ROOT}}", "--step-id", "clarify_requirements", "--status", "in_progress", "--summary", "clarifying requirements"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "clarify_requirements", "--condition-result", "{\"condition_id\":\"requirements_ready\",\"output\":{\"type\":\"path\",\"value\":\"require_points.md\"}}", "--next-step-id", "confirm_requirements", "--summary", "requirements ready"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "confirm_requirements", "--condition-result", "{\"condition_id\":\"requirements_approved\",\"output\":{\"type\":\"enum_value\",\"value\":\"approved\"}}", "--next-step-id", "write_promotion_design", "--summary", "requirements approved", "--evidence", "{\"source\":\"human\",\"content\":\"approved\",\"ref\":\"contract-requirements-approval\"}"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "write_promotion_design", "--condition-result", "{\"condition_id\":\"promotion_design_written\",\"output\":{\"type\":\"path\",\"value\":\"方案.md\"}}", "--next-step-id", "review_promotion_design", "--summary", "promotion design written"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "review_promotion_design", "--condition-result", "{\"condition_id\":\"design_review_passed\",\"output\":{\"type\":\"enum_value\",\"value\":\"passed\"}}", "--condition-result", "{\"condition_id\":\"design_review_written\",\"output\":{\"type\":\"path\",\"value\":\".promotion/review.md\"}}", "--next-step-id", "confirm_promotion_design", "--summary", "design review passed"]},
    {"args": ["card", "render", "--root", "{{ROOT}}", "--dry-run", "--view", "panorama", "--format", "markdown"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "confirm_promotion_design", "--condition-result", "{\"condition_id\":\"promotion_design_approved\",\"output\":{\"type\":\"enum_value\",\"value\":\"approved\"}}", "--terminal", "--summary", "promotion design approved", "--evidence", "{\"source\":\"human\",\"content\":\"approved\",\"ref\":\"contract-design-approval\"}"]},
    {"args": ["flow", "status", "--root", "{{ROOT}}"]}
  ]
}
