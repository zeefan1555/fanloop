{
  "schema_version": 1,
  "id": "material-flashcards-happy",
  "commands": [
    {"args": ["flow", "init", "--root", "{{ROOT}}", "--workflow", "material-flashcards", "--title", "Material Flashcards Contract"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "frame_review_goal", "--condition-result", "{\"condition_id\":\"review_goal_framed\",\"output\":{\"type\":\"path\",\"value\":\"artifacts/review-goal.md\"}}", "--next-step-id", "understand_source", "--summary", "review goal ready"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "understand_source", "--condition-result", "{\"condition_id\":\"source_understood\",\"output\":{\"type\":\"path\",\"value\":\"artifacts/source-understanding.md\"}}", "--next-step-id", "select_knowledge", "--summary", "source understood"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "select_knowledge", "--condition-result", "{\"condition_id\":\"knowledge_selected\",\"output\":{\"type\":\"path\",\"value\":\"artifacts/knowledge-selection.md\"}}", "--next-step-id", "plan_card_set", "--summary", "knowledge selected"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "plan_card_set", "--condition-result", "{\"condition_id\":\"card_plan_ready\",\"output\":{\"type\":\"path\",\"value\":\"artifacts/card-plan.md\"}}", "--next-step-id", "draft_cards", "--summary", "card plan ready"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "draft_cards", "--condition-result", "{\"condition_id\":\"card_draft_ready\",\"output\":{\"type\":\"path\",\"value\":\"artifacts/cards.md\"}}", "--next-step-id", "review_card_quality", "--summary", "two cards drafted"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "review_card_quality", "--condition-result", "{\"condition_id\":\"quality_review_written\",\"output\":{\"type\":\"path\",\"value\":\"artifacts/quality-review.md\"}}", "--condition-result", "{\"condition_id\":\"card_quality_passed\",\"output\":{\"type\":\"enum_value\",\"value\":\"passed\"}}", "--next-step-id", "confirm_card_preview", "--summary", "quality passed", "--evidence", "{\"source\":\"file\",\"content\":\"artifacts/quality-review.md\",\"ref\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}"]},
    {"args": ["card", "render", "--root", "{{ROOT}}", "--dry-run", "--view", "panorama", "--format", "markdown"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "confirm_card_preview", "--condition-result", "{\"condition_id\":\"card_preview_published\",\"output\":{\"type\":\"object\",\"value\":{\"preview_path\":\"artifacts/preview.md\",\"preview_sha256\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"quality_review_path\":\"artifacts/quality-review.md\",\"quality_review_sha256\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"draft_path\":\"artifacts/cards.md\",\"draft_sha256\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"target_path\":\"Decks/material.md\",\"preview_record_path\":\"artifacts/preview-record.json\",\"preview_record_sha256\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}}}", "--condition-result", "{\"condition_id\":\"panorama_card_published\",\"output\":{\"type\":\"path\",\"value\":\".fanloop/card/material-flashcards.json\"}}", "--condition-result", "{\"condition_id\":\"card_preview_approved\",\"output\":{\"type\":\"object\",\"value\":{\"decision\":\"approved\",\"quality_review_path\":\"artifacts/quality-review.md\",\"quality_review_sha256\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"draft_path\":\"artifacts/cards.md\",\"draft_sha256\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"target_path\":\"Decks/material.md\",\"preview_record_path\":\"artifacts/preview-record.json\",\"preview_record_sha256\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"approval_record_path\":\"artifacts/approval-record.json\",\"approval_record_sha256\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"sender_type\":\"human\"}}}", "--next-step-id", "persist_approved_cards", "--summary", "two-card preview approved", "--evidence", "{\"source\":\"file\",\"content\":\"artifacts/approval-record.json\",\"ref\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "persist_approved_cards", "--condition-result", "{\"condition_id\":\"cards_persisted\",\"output\":{\"type\":\"object\",\"value\":{\"approved_draft_sha256\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"target_path\":\"Decks/material.md\",\"written_path\":\"Decks/material.md\",\"written_sha256\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"card_count\":2}}}", "--next-step-id", "validate_persisted_cards", "--summary", "two cards persisted"]},
    {"args": ["flow", "report", "result", "--root", "{{ROOT}}", "--step-id", "validate_persisted_cards", "--condition-result", "{\"condition_id\":\"post_write_validation_written\",\"output\":{\"type\":\"path\",\"value\":\"artifacts/post-write-validation.md\"}}", "--condition-result", "{\"condition_id\":\"persisted_cards_validated\",\"output\":{\"type\":\"enum_value\",\"value\":\"passed\"}}", "--terminal", "--summary", "persisted cards validated"]},
    {"args": ["flow", "status", "--root", "{{ROOT}}"]}
  ]
}
