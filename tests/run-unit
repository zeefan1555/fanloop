#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

test_data_root="$(mktemp -d "${TMPDIR:-/tmp}/fanloop-unit.XXXXXX")"
generated_root="$(mktemp -d "${TMPDIR:-/tmp}/fanloop-generated.XXXXXX")"
[[ -d "$test_data_root" && -d "$generated_root" ]] || exit 1
cleanup() {
  rm -rf -- "$test_data_root" "$generated_root"
}
trap cleanup EXIT
export FANLOOP_DATA_HOME="$test_data_root"

unformatted="$({
  while IFS= read -r -d '' file; do
    [[ -f "$file" ]] || continue
    gofmt -l "$file"
  done < <(git ls-files -co --exclude-standard -z -- '*.go')
})"
if [[ -n "$unformatted" ]]; then
  echo "Go files require gofmt:" >&2
  echo "$unformatted" >&2
  exit 1
fi

OUTPUT_ROOT="$generated_root" ./scripts/generate-cli-idl.sh

generated_files() {
  local root="$1" file first
  while IFS= read -r -d '' file; do
    IFS= read -r first < "$file" || true
    case "$first" in
      '// Code generated by thriftgo'*|'// Code generated by Validator'*|'// Code generated by tools/command-spec-gen'*)
        printf '%s\n' "${file#"$root"/}"
        ;;
    esac
  done < <(find "$root" -type f -name '*.go' -print0)
}

expected="$(generated_files "$generated_root" | sort)"
actual="$(generated_files "$repo_root" | sort)"
if [[ "$actual" != "$expected" ]]; then
  echo "Generated file set is stale:" >&2
  diff -u <(printf '%s\n' "$expected") <(printf '%s\n' "$actual") >&2 || true
  exit 1
fi
while IFS= read -r file; do
  if ! cmp -s "$generated_root/$file" "$repo_root/$file"; then
    echo "Generated file is stale: $file" >&2
    diff -u "$repo_root/$file" "$generated_root/$file" >&2 || true
    exit 1
  fi
done <<< "$expected"

go vet ./...
go test -short -buildvcs=false ./...
npm test
PYTHONDONTWRITEBYTECODE=1 python3 tests/requirement_e2e/test_route_matrix.py
